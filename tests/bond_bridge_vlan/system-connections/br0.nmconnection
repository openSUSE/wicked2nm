[connection]
id=br0
uuid=74ee660a-1fce-466a-a03c-40c72b606e27
type=bridge
autoconnect-ports=1
interface-name=br0

[ethernet]
mtu=9000

[bridge]
stp=false

[match]

[ipv4]
address1=10.0.2.2/15
dns-priority=20
method=manual

[ipv6]
addr-gen-mode=default
dns-priority=20
ip6-privacy=1
method=auto

[proxy]
